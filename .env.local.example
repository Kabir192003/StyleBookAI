# Google Gemini
GEMINI_API_KEY=

# Auth — simple username/password (see lib/auth/). Any long random string;
# generate one with `openssl rand -base64 32`. Changing this invalidates
# every existing session.
AUTH_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — not needed yet, billing is deferred until post-launch.
# Uncomment and fill in when we turn on paid plans:
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=

# Google Fonts
GOOGLE_FONTS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
